<?xml version="1.0" ?>
<model>
    <name>x500_with_arm</name>
    <version>1.0</version>
    <sdf version="1.9">model.sdf</sdf>
    <description>
        Holybro X500 with 2-DOF robotic arm for ArduPilot SITL.
        Arm joints controlled via SERVO9/SERVO10 (AUX1/AUX2) with FUNCTION=0
        and MAV_CMD_DO_SET_SERVO.
    </description>
</model>
